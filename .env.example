# Required: Hugging Face token for the Inference Router / LLM
HF_TOKEN=

# Optional: Neon PostgreSQL. When unset, RAG uses ephemeral Chroma only.
# Option A — libpq-style vars (recommended; password stays out of a long URL):
# PGUSER=neondb_owner
# PGPASSWORD=
# PGHOST=your-project-pooler.region.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb

# Option B — full connection string (URL-encode special characters in password):
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional database settings (defaults shown)
# DB_CACHE_TTL_HOURS=168
# DB_VECTOR_DIMENSIONS=1024

# Optional local bind overrides
# HOST=127.0.0.1
# PORT=7860
