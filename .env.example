# Required: Hugging Face token for the Inference Router / LLM
HF_TOKEN=

# Optional: MongoDB Atlas URI. When unset, RAG uses ephemeral Chroma only.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Optional Mongo settings (defaults shown)
# MONGODB_DB_NAME=synonym_generator
# MONGODB_CACHE_TTL_HOURS=168
# MONGODB_VECTOR_INDEX_NAME=chunk_vectors_vector_index
# MONGODB_VECTOR_DIMENSIONS=1024

# Optional local bind overrides
# HOST=127.0.0.1
# PORT=7860
